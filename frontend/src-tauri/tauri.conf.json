{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustFox",
  "version": "0.0.2",
  "identifier": "com.rustfox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
"windows": [
      {
        "label": "main",
        "title": "RustFox",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 15 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/weihubeats/RustFox/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NUU4NUY4NzNGOTkwNzkKUldSNWtQbHorSVZlR1RyZ0M0MmdIWTA3QW91S1NaWWRxamhReFZnaS9XdkplR2ErSWRUUGJheXAK"
    }
  }
}